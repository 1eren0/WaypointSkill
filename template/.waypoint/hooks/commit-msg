#!/bin/sh
# Checks commit message type and reminds about recording lessons.

cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || exit 0

# The project's own commit-msg hook from before Waypoint (if any) runs first.
sh .waypoint/hooks/onceki-hook commit-msg "$1" || exit 1

PYTHON=""
if [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  PYTHON="python3"
elif [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
  PYTHON="python"
elif [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v py >/dev/null 2>&1 && py -3 --version >/dev/null 2>&1; then
  PYTHON="py -3"
fi

if [ -z "$PYTHON" ]; then
  printf '%s\n' "❌ Python 3 bulunamadı; Waypoint kuralları denetlenemediği için kayıt engellendi." "   Python 3'ü kurun: https://www.python.org/downloads/ (Windows'ta kurulumda \"Add python.exe to PATH\" kutusunu işaretleyin), sonra tekrar deneyin." >&2
  exit 1
fi
$PYTHON .waypoint/hooks/kontrol.py --mesaj "$1"
exit $?
