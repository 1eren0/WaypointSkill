#!/bin/sh
# Checks project rules, then runs the project's tests before every commit.
# The test command is the first `backticked` line under "## Testleri çalıştırma"
# in .waypoint/ILERLEME.md. If it's missing or still "...", there are no tests yet → allow (kontrol.py warns when code changed).
# Tests stop after 5 minutes (WAYPOINT_TEST_TIMEOUT, in seconds, changes this).

cd "$(git rev-parse --show-toplevel)" || exit 1

# The project's own pre-commit hook from before Waypoint (if any) runs first, e.g. a formatter.
sh .waypoint/hooks/onceki-hook pre-commit || exit 1

PYTHON=""
if [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  PYTHON="python3"
elif [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
  PYTHON="python"
elif [ "${WAYPOINT_NO_PYTHON:-}" != "1" ] && command -v py >/dev/null 2>&1 && py -3 --version >/dev/null 2>&1; then
  PYTHON="py -3"
fi

if [ -z "$PYTHON" ]; then
  printf '%s\n' "❌ Python 3 bulunamadı; Waypoint kuralları denetlenemediği için kayıt engellendi." "   Python 3'ü kurun: https://www.python.org/downloads/ (Windows'ta kurulumda \"Add python.exe to PATH\" kutusunu işaretleyin), sonra tekrar deneyin." >&2
  exit 1
fi

# Rules first, then the tests (with a time limit, so a test runner left in watch mode can't hang the commit).
$PYTHON .waypoint/hooks/kontrol.py || exit 1
$PYTHON .waypoint/hooks/kontrol.py --test || exit 1
exit 0
